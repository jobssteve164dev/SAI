{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sai.world/spec/0.2.0/trust-directory.schema.json",
  "title": "SAI Signed Node Trust Directory",
  "type": "object",
  "required": ["protocol", "directory_id", "sequence", "issuer", "issued_at", "expires_at", "previous_directory_hash", "entries", "signature"],
  "properties": {
    "protocol": {"const": "sai-federation/0.2.0"},
    "directory_id": {"type": "string", "pattern": "^node:ed25519-v1:[A-Za-z0-9_-]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "issuer": {"type": "object"},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0},
    "previous_directory_hash": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{43}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "status", "reputation", "since", "incident_ids"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^node:ed25519-v1:[A-Za-z0-9_-]+$"},
          "status": {"enum": ["admitted", "suspended", "revoked"]},
          "reputation": {"type": "integer", "minimum": -100, "maximum": 100},
          "since": {"type": "integer", "minimum": 0},
          "incident_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "signature": {"type": "string", "minLength": 32}
  },
  "additionalProperties": false
}
