{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sai.world/spec/0.2.0/route-manifest.schema.json",
  "title": "SAI Region Route Manifest",
  "type": "object",
  "required": ["protocol", "route_version", "parent_region", "parent_state_hash", "axis", "coordinate", "children"],
  "properties": {
    "protocol": {"const": "sai-federation/0.2.0"},
    "route_version": {"type": "integer", "minimum": 1},
    "parent_region": {"type": "string"},
    "parent_state_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "axis": {"enum": ["x", "y"]},
    "coordinate": {"type": "integer", "minimum": 1},
    "children": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["region_id", "min_x", "min_y", "max_x", "max_y", "state_hash"],
        "properties": {
          "region_id": {"type": "string"},
          "min_x": {"type": "integer", "minimum": 0},
          "min_y": {"type": "integer", "minimum": 0},
          "max_x": {"type": "integer", "minimum": 0},
          "max_y": {"type": "integer", "minimum": 0},
          "state_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
