{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sai.world/spec/0.2.0/transfer-credential.schema.json",
  "title": "SAI Cross-region Transfer Credential",
  "type": "object",
  "required": ["protocol", "transfer_id", "source_node", "source_region", "target_node", "target_region", "agent", "agent_public_jwk", "source_state_hash", "issued_at", "expires_at", "nonce", "signature"],
  "properties": {
    "protocol": {"const": "sai-federation/0.2.0"},
    "transfer_id": {"type": "string", "pattern": "^transfer_[A-Za-z0-9_-]+$"},
    "source_node": {"type": "object"},
    "source_region": {"type": "string"},
    "target_node": {"type": "string"},
    "target_region": {"type": "string"},
    "agent": {"type": "object"},
    "agent_public_jwk": {"type": "object"},
    "source_state_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 160},
    "signature": {"type": "string", "minLength": 32}
  },
  "additionalProperties": false
}
