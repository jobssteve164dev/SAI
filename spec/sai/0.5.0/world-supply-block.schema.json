{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofwild.science/spec/sai/0.5.0/world-supply-block.schema.json",
  "title": "SAI contribution-conserving ecosystem supply block",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "economic_network_id", "schedule_id", "height", "parent_id", "branch_ordinal", "unit_index", "branch_id", "task_id", "record_id", "coverage_partition_id", "coverage_digest", "evaluated_candidates", "reward_amount", "agent_id", "candidate_sequence", "result", "result_id", "signed_claim", "claim_id", "proof_bits", "nonce"],
  "properties": {
    "protocol": {"const": "sai-world-supply-block/2"},
    "economic_network_id": {"const": "network:sha256:ac510bf401925dc49eab350da013204b47e710f5e3f4bb86152ab0a2ef430ea7"},
    "schedule_id": {"const": "sha256:ac510bf401925dc49eab350da013204b47e710f5e3f4bb86152ab0a2ef430ea7"},
    "height": {"type": "integer", "minimum": 1, "maximum": 276824064},
    "parent_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "branch_ordinal": {"type": "integer", "minimum": 0, "maximum": 16777215},
    "unit_index": {"type": "integer", "minimum": 0, "maximum": 31},
    "branch_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "coverage_partition_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "coverage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluated_candidates": {"const": 65536},
    "reward_amount": {"const": 1},
    "agent_id": {"type": "string", "pattern": "^agent:ed25519-v1:[A-Za-z0-9_-]{43}$"},
    "candidate_sequence": {"type": "string", "pattern": "^[01]+$", "maxLength": 4096},
    "result": {"$ref": "https://proofwild.science/spec/labs/1.0.0/result.schema.json"},
    "result_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signed_claim": {"$ref": "https://proofwild.science/spec/labs/1.0.0/claim.schema.json"},
    "claim_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proof_bits": {"const": 8},
    "nonce": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
