{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofwild.science/spec/sai/0.5.0/world-supply-schedule.schema.json",
  "title": "SAI contribution-conserving ecosystem supply schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "base_unit", "world_axis", "world_cells", "resource_tile_axis", "rewarded_branch_count", "strata", "branches_per_stratum", "branch_capacity_formula", "settlement_reward_formula", "candidates_per_research_unit", "research_partition_address_bits", "research_partition_variable_bits", "research_challenge_bits", "research_partition_encoding", "research_challenge_encoding", "research_task_protocol", "research_record_protocol", "research_method_artifact_id", "cumulative_supply_formula", "max_supply", "ordinal_permutation", "position_formula", "resource_classes", "proof_bits", "fork_choice", "season_reset", "ruleset_id"],
  "properties": {
    "protocol": {"const": "sai-world-supply-schedule/3"},
    "base_unit": {"const": "world_resource_unit"},
    "world_axis": {"const": 65536},
    "world_cells": {"const": 4294967296},
    "resource_tile_axis": {"const": 16},
    "rewarded_branch_count": {"const": 16777216},
    "strata": {"const": 32},
    "branches_per_stratum": {"const": 524288},
    "branch_capacity_formula": {"const": "one_based_stratum"},
    "settlement_reward_formula": {"const": "one_unit_per_verified_unique_research_partition"},
    "candidates_per_research_unit": {"const": 65536},
    "research_partition_address_bits": {"const": 29},
    "research_partition_variable_bits": {"const": 16},
    "research_challenge_bits": {"const": 128},
    "research_partition_encoding": {"const": "xor31_of_branch_ordinal_24bit_and_unit_index_5bit"},
    "research_challenge_encoding": {"const": "sha256_128_of_network_parent_and_claimant"},
    "research_task_protocol": {"const": "sai-labs-research-task/2"},
    "research_record_protocol": {"const": "sai-labs-research-record/2"},
    "research_method_artifact_id": {"const": "sha256:26ab5bc877c548e31c596cc0b405284b92d6ccf1f1b7951a232c74d1245c69e4"},
    "cumulative_supply_formula": {"const": "2^18*k*(k+1)"},
    "max_supply": {"const": 276824064},
    "ordinal_permutation": {"type": "object", "additionalProperties": false, "required": ["algorithm", "multiplier", "offset"], "properties": {"algorithm": {"const": "affine_mod_2^24"}, "multiplier": {"const": 5939339}, "offset": {"const": 11841497}}},
    "position_formula": {"type": "object", "additionalProperties": false, "required": ["algorithm", "seed"], "properties": {"algorithm": {"const": "sha256_tile_offset"}, "seed": {"const": "sai-world-strata-position-2026-08"}}},
    "resource_classes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"const": {"kind": "crystal", "length": 451, "baseline_energy": "12625"}},
        {"const": {"kind": "fiber", "length": 518, "baseline_energy": "18463"}},
        {"const": {"kind": "catalyst", "length": 573, "baseline_energy": "22558"}}
      ],
      "items": false
    },
    "proof_bits": {"const": 8},
    "fork_choice": {"const": "cumulative_work_then_smallest_tip"},
    "season_reset": {"const": false},
    "ruleset_id": {"const": "sha256:00e98f457d47ed2de88d956987d66c2398bc26da1292fe9d098bc3120a3db621"}
  }
}
