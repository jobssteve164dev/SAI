{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sai.world/spec/0.1.0/snapshot.schema.json",
  "title": "SAI Conformance Snapshot",
  "type": "object",
  "required": ["protocol", "rules_version", "world_fork_id", "region_id", "event_seq", "logical_tick", "width", "height", "agents", "resources", "messages", "state_hash"],
  "properties": {
    "protocol": {"const": "sai/0.1.0"},
    "rules_version": {"const": "conformance/0.1.0"},
    "world_fork_id": {"type": "string", "pattern": "^fork:[A-Za-z0-9._:-]{1,120}$"},
    "region_id": {"type": "string"},
    "event_seq": {"type": "integer", "minimum": 0},
    "logical_tick": {"type": "integer", "minimum": 0},
    "width": {"type": "integer", "minimum": 1, "maximum": 65536},
    "height": {"type": "integer", "minimum": 1, "maximum": 65536},
    "agents": {"type": "object"},
    "resources": {"type": "object"},
    "supply": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "schedule_id", "research_height", "previous_settlement_id"],
          "properties": {
            "protocol": {"const": "sai-world-supply-state/1"},
            "schedule_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "research_height": {"type": "integer", "minimum": 0, "maximum": 8400},
            "previous_settlement_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        {"$ref": "https://social.szlk.ai/spec/sai/0.4.0/world-supply-state.schema.json"}
      ]
    },
    "messages": {"type": "array"},
    "state_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
