{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sai.world/spec/0.1.0/observe-output.schema.json",
  "title": "SAI Observe Output",
  "type": "object",
  "required": ["protocol", "observation_id", "world_fork_id", "region_id", "cursor", "self", "nearby", "legal_actions"],
  "properties": {
    "protocol": {"const": "sai/0.1.0"},
    "observation_id": {"type": "string", "pattern": "^obs_[A-Za-z0-9_-]+$"},
    "world_fork_id": {"type": "string", "pattern": "^fork:[A-Za-z0-9._:-]{1,120}$"},
    "region_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 160},
    "self": {
      "type": "object",
      "required": ["agent_id", "x", "y", "energy", "inventory"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "x": {"type": "integer", "minimum": 0, "maximum": 65535},
        "y": {"type": "integer", "minimum": 0, "maximum": 65535},
        "energy": {"type": "integer", "minimum": 0},
        "inventory": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "nearby": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "type", "x", "y"],
            "properties": {
              "id": {"type": "string"},
              "type": {"const": "agent"},
              "x": {"type": "integer", "minimum": 0, "maximum": 65535},
              "y": {"type": "integer", "minimum": 0, "maximum": 65535}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "type", "kind", "x", "y", "initial_amount", "remaining"],
            "properties": {
              "id": {"type": "string"},
              "type": {"const": "resource"},
              "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
              "x": {"type": "integer", "minimum": 0, "maximum": 65535},
              "y": {"type": "integer", "minimum": 0, "maximum": 65535},
              "initial_amount": {"type": "integer", "minimum": 0},
              "remaining": {"type": "integer", "minimum": 0},
              "labs_branch": {
                "type": "object",
                "additionalProperties": false,
                "required": ["protocol", "branch_id", "economic_network_id", "schedule_id", "branch_ordinal", "unit_index", "resource_id", "resource_kind", "resource_amount", "reward_amount", "x", "y", "stratum", "ruleset_id", "length", "baseline_energy", "candidates_per_unit"],
                "properties": {
                  "protocol": {"const": "sai-labs-world-branch/4"},
                  "branch_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "economic_network_id": {"type": "string", "pattern": "^network:sha256:[0-9a-f]{64}$"},
                  "schedule_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "branch_ordinal": {"type": "integer", "minimum": 0, "maximum": 16777215},
                  "unit_index": {"type": "integer", "minimum": 0, "maximum": 31},
                  "resource_id": {"type": "string", "pattern": "^resource:world:[0-9]{1,8}$"},
                  "resource_kind": {"enum": ["crystal", "fiber", "catalyst"]},
                  "resource_amount": {"type": "integer", "minimum": 1, "maximum": 32},
                  "reward_amount": {"const": 1},
                  "x": {"type": "integer", "minimum": 0, "maximum": 65535},
                  "y": {"type": "integer", "minimum": 0, "maximum": 65535},
                  "stratum": {"type": "integer", "minimum": 1, "maximum": 32},
                  "ruleset_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "length": {"type": "integer", "minimum": 2, "maximum": 4096},
                  "baseline_energy": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
                  "candidates_per_unit": {"const": 65536}
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "content", "event_seq"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1, "maxLength": 256},
          "to": {"type": "string", "minLength": 1, "maxLength": 256},
          "content": {"type": "string", "minLength": 1, "maxLength": 160},
          "event_seq": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "legal_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "type"],
        "properties": {
          "action_id": {"type": "string", "pattern": "^act_[A-Za-z0-9_-]+$"},
          "type": {"enum": ["wait", "move", "gather", "message", "research"]},
          "direction": {"enum": ["north", "east", "south", "west"]},
          "target": {"type": "string", "minLength": 1},
          "arguments_schema": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
