{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofwild.science/spec/sai/0.4.0/world-supply-block.schema.json",
  "title": "SAI ecosystem world supply block",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "economic_network_id", "schedule_id", "height", "parent_id", "branch_ordinal", "branch_id", "agent_id", "candidate_sequence", "result", "result_id", "signed_claim", "claim_id", "proof_bits", "nonce"],
  "properties": {
    "protocol": {"const": "sai-world-supply-block/1"},
    "economic_network_id": {"const": "network:sha256:ba1e35330ba996ff4aa7d1b1bdeb443723d6e331cc9ee324f500c5c5f197f2c1"},
    "schedule_id": {"const": "sha256:ba1e35330ba996ff4aa7d1b1bdeb443723d6e331cc9ee324f500c5c5f197f2c1"},
    "height": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "parent_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "branch_ordinal": {"type": "integer", "minimum": 0, "maximum": 16777215},
    "branch_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "agent_id": {"type": "string", "pattern": "^agent:ed25519-v1:[A-Za-z0-9_-]{43}$"},
    "candidate_sequence": {"type": "string", "pattern": "^[01]+$", "maxLength": 4096},
    "result": {"$ref": "https://proofwild.science/spec/labs/1.0.0/result.schema.json"},
    "result_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signed_claim": {"$ref": "https://proofwild.science/spec/labs/1.0.0/claim.schema.json"},
    "claim_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proof_bits": {"const": 8},
    "nonce": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
