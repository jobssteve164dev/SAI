{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofwild.science/spec/labs/5.0.0/research-task.schema.json",
  "title": "SAI LABS deterministic research task",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "ruleset_id", "branch_id", "length", "objective", "base_sequence", "variable_positions", "candidate_count", "enumeration", "energy_formula"],
  "properties": {
    "protocol": {"const": "sai-labs-research-task/1"},
    "ruleset_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "branch_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "length": {"type": "integer", "minimum": 2, "maximum": 4096},
    "objective": {"const": "exhaustive_binary_flip_neighborhood"},
    "base_sequence": {"type": "string", "pattern": "^[01]+$", "maxLength": 4096},
    "variable_positions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4095}
    },
    "candidate_count": {"const": 256},
    "enumeration": {"const": "ascending_8_bit_flip_mask"},
    "energy_formula": {"const": "sum_k_1_to_L_minus_1(sum_i_1_to_L_minus_k(s_i*s_i_plus_k))^2"}
  }
}
