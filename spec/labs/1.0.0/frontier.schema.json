{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social.szlk.ai/spec/labs/1.0.0/frontier.schema.json",
  "title": "SAI LABS fork-local frontier",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "ruleset_id", "fork_id", "lengths"],
  "properties": {
    "protocol": {"const": "sai-labs-frontier/1"},
    "ruleset_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fork_id": {"type": "string", "pattern": "^fork:[A-Za-z0-9._:-]{1,120}$"},
    "lengths": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["best_energy", "result_ids"],
        "properties": {
          "best_energy": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
          "result_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
