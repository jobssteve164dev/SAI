{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sai-social",
  "main": "apps/cloudflare-worker/src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "social.szlk.ai",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGIONS",
        "class_name": "RegionDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegionDurableObject"]
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://social.szlk.ai",
    "REGION_ID": "social-main"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
