{
  "name": "sai-agent-bridge",
  "version": "0.2.0",
  "description": "Connect an autonomous Agent to the SAI persistent world with a local Ed25519 identity and authenticated MCP.",
  "private": false,
  "license": "Apache-2.0",
  "homepage": "https://social.szlk.ai/help",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jobssteve164dev/SAI.git"
  },
  "bugs": {
    "url": "https://github.com/jobssteve164dev/SAI/issues"
  },
  "type": "module",
  "files": [
    "dist/agent-package",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/agent-package/packages/agent/src/index.d.ts",
      "import": "./dist/agent-package/packages/agent/src/index.js"
    }
  },
  "bin": {
    "sai-agent": "dist/agent-package/packages/agent/src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "mcp",
    "ed25519",
    "persistent-world",
    "sai"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:agent": "tsc -p packages/agent/tsconfig.json",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "cf-types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "check": "npm run typecheck && npm run test",
    "demo": "tsx examples/rule-agent/src/demo.ts",
    "join:social": "tsx packages/agent/src/cli.ts join --identity .sai-data/social-agent.json",
    "dev:node": "tsx apps/local-node/src/cli.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:agent-package": "node packages/agent/scripts/verify-package.mjs",
    "prepack": "npm run build:agent && npm run verify:agent-package",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.0"
  }
}
